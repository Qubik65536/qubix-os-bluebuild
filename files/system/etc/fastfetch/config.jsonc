// ── oxocarbon · Nerd Font · rounded box ──────────────────────────────────────
// Read by: fastfetch, as /etc/fastfetch/config.jsonc — the system-wide default.
//          Its search path is ~/.config → $HOME → $XDG_CONFIG_DIRS → /etc/xdg →
//          /etc, first match wins, so ~/.config/fastfetch/config.jsonc replaces
//          this file wholesale and there is nothing here to undo. Nothing runs
//          fastfetch for you; this is what `fastfetch` looks like when you type it.
//
// Companion piece to /usr/share/qubix-os/starship.toml.
// Structure/brackets/spine = purple; each row's content = its accent. No gray text.
//
//   base #161616 · gray #525252 · teal #08bdba · cyan #3ddbd9 · blue #78a9ff
//   ltblue #33b1ff · sky #82cfff · magenta #ee5396 · pink #ff7eb6
//   green #42be65 · purple #be95ff
//
// ── how the box stays square ─────────────────────────────────────────────────
// Nerd Font icons are not all one cell wide (many faces, this image's
// cascadia-mono-nf included, draw a good number of them double-wide), so counting
// characters can never align a column. Every edge is
// instead pinned with CHA — `ESC[<n>G` moves the cursor to absolute column n —
// which the terminal resolves *after* it has drawn the glyphs. Four columns
// are fixed, so icon width cannot shift anything:
//
//   col  23   left spine   │      = logo gutter (22) + 1
//   col  29   label start          first letter of every label lands here
//   col  39   separator    ·
//   col  90   right spine  │
//
// Each key jumps to col 90 to draw the right edge *first*, comes back to 23
// for the spine, prints the icon, then jumps to 29 for the label. Keeping the
// border inside the key means every module keeps its own default `format`.
//
// Needs a terminal ≥ 90 columns. Values get cols 42–89 (48 chars); anything
// longer overruns the right spine, so keep formats tight.
//
// ── the logo gutter, and changing the logo ───────────────────────────────────
// The only number that depends on the logo is the gutter, and the four columns
// above are derived from it. `fedora_small` is 16 columns wide, +2 left +4 right
// padding = 22, hence the spine at 23. The full `fedora` logo is 38 wide, which
// would push the right spine to 112 — wider than a WezTerm tiled to half of a
// 1920px panel, which is where this image spends most of its time. Hence small.
//
// To use a different logo, change "source" below and then re-derive the columns:
//
//   cp /etc/fastfetch/config.jsonc ~/.config/fastfetch/config.jsonc
//   $EDITOR ~/.config/fastfetch/config.jsonc          # set "source"
//   /usr/share/qubix-os/fastfetch/retune.sh           # rewrites all four columns
//
// ── syntax notes ─────────────────────────────────────────────────────────────
// Hex colours inside format/key strings are written `{##rrggbb}`: the first #
// opens the colour placeholder, the second belongs to the hex. Colour
// placeholders do NOT work in display.separator — display.color.separator
// colours it instead. `\u001b` is the ESC that starts each CHA jump.
//
// Row icons are written as \uXXXX escapes rather than literal glyphs — they
// live in the Unicode Private Use Area, which editors, clipboards and diff
// tools silently drop. Mostly Font Awesome (U+F0xx–U+F2xx), devicons for the
// toolchain (U+E6xx–U+E7xx), plus two Material Design ones written as
// surrogate pairs (gpu U+F08AE, display U+F0379). Swap one by editing its
// escape; the label column is pinned, so a wider glyph shifts nothing.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // Pinned, NOT auto-detected. Detection reads ID= from os-release, which this
    // image rewrites to `qubix_os_bluebuild` (DD-003) — a name fastfetch has never
    // heard of, so it falls back to its generic penguin — 23 columns wide, a
    // 29-column gutter, and every column above then off by seven. Naming the logo
    // is what makes the layout deterministic.
    // Qubix OS is Fedora Atomic underneath, so the Fedora mark is the honest one.
    "source": "fedora_small",
    "type": "builtin",
    "padding": { "top": 2, "left": 2, "right": 4 },
    "color": {
      "1": "#42be65",
      "2": "#ff7eb6",
      "3": "#ee5396",
      "4": "#be95ff",
      "5": "#78a9ff",
      "6": "#3ddbd9"
    }
  },

  "display": {
    "separator": "\u001b[39G·  ",
    "color": {
      "title": "#be95ff",
      "separator": "#be95ff",
      "keys": "#be95ff" // suppresses fastfetch's default bold-yellow key style
    },
    "brightColor": false,
    "percent": {
      "type": 9, // 1 = number, 3 = number + bar, 6 = bar only, 9 = coloured number
      "ndigits": 0,
      "color": { "green": "#42be65", "yellow": "#ff7eb6", "red": "#ee5396" }
    },
    "bar": {
      "char": { "elapsed": "▪", "total": "▫" },
      "border": { "left": "", "right": "" },
      "color": { "elapsed": "#be95ff", "total": "#525252" },
      "width": 12
    },
    "size": { "ndigits": 1, "binaryPrefix": "si" },
    "temp": { "ndigits": 1 },
    "key": { "type": "string" }
  },

  "modules": [
    // ── system ───────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "{##be95ff}╭─ [ system ] ─────────────────────────────────────────────────────\u001b[90G╮"
    },
    {
      "type": "title",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##78a9ff}\uf007\u001b[29G",
      "format": "{##78a9ff}{user-name}{##be95ff} · {##08bdba}{host-name}"
    },
    {
      "type": "os",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf108\u001b[29Gos",
      "format": "{name} {version} {##be95ff}·{##82cfff} {codename}",
      "outputColor": "#82cfff"
    },
    {
      "type": "host",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##33b1ff}\uf109\u001b[29Ghost",
      "outputColor": "#33b1ff"
    },
    {
      "type": "kernel",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##3ddbd9}\uf013\u001b[29Gkernel",
      "format": "{sysname} {release}",
      "outputColor": "#3ddbd9"
    },
    {
      "type": "initsystem",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##08bdba}\uf085\u001b[29Ginit",
      "outputColor": "#08bdba"
    },
    {
      "type": "bootmgr",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##08bdba}\uf0e7\u001b[29Gboot",
      "outputColor": "#08bdba"
    },
    {
      "type": "packages",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ff7eb6}\uf187\u001b[29Gpackages",
      "outputColor": "#ff7eb6"
    },
    {
      "type": "shell",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##3ddbd9}\uf120\u001b[29Gshell",
      "format": "{pretty-name} {version}",
      "outputColor": "#3ddbd9"
    },
    {
      "type": "terminal",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf2d0\u001b[29Gterm",
      "format": "{pretty-name} {version}",
      "outputColor": "#82cfff"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##78a9ff}\uf031\u001b[29Gtermfont",
      "outputColor": "#78a9ff"
    },
    {
      // Linux: desktop environment · macOS: Aqua
      "type": "de",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##42be65}\uf009\u001b[29Gde",
      "format": "{pretty-name} {version}",
      "outputColor": "#42be65"
    },
    {
      "type": "wm",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##be95ff}\uf2d2\u001b[29Gwm",
      "format": "{pretty-name} {version}",
      "outputColor": "#be95ff"
    },
    {
      // Linux only (gdm/sddm/…)
      "type": "lm",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##33b1ff}\uf090\u001b[29Glm",
      "outputColor": "#33b1ff"
    },
    {
      "type": "theme",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ee5396}\uf1fc\u001b[29Gtheme",
      "outputColor": "#ee5396"
    },
    {
      // Linux only (icon theme)
      "type": "icons",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ff7eb6}\uf03e\u001b[29Gicons",
      "outputColor": "#ff7eb6"
    },
    {
      // Linux: system UI font · macOS: system + user font
      "type": "font",
      "format": "{font1}", // {combined} lists them all, but it overruns the box
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf1dc\u001b[29Gfont",
      "outputColor": "#82cfff"
    },

    // ── hardware ─────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "{##be95ff}├─ [ hardware ] ───────────────────────────────────────────────────\u001b[90G┤"
    },
    {
      "type": "cpu",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##3ddbd9}\uf2db\u001b[29Gcpu",
      "format": "{name} {##be95ff}·{##3ddbd9} {cores-logical} cores {##be95ff}·{##3ddbd9} {freq-max}",
      "outputColor": "#3ddbd9",
      "showPeCoreCount": true
    },
    {
      "type": "cpuusage",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf080\u001b[29Gusage",
      "format": "{avg}",
      "outputColor": "#82cfff",
      "separate": false
    },
    {
      "type": "loadavg",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##08bdba}\uf0e4\u001b[29Gload",
      "outputColor": "#08bdba",
      "compact": true
    },
    {
      "type": "gpu",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##42be65}\udb82\udcae\u001b[29Ggpu",
      "outputColor": "#42be65"
    },
    {
      "type": "memory",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ff7eb6}\uf1c0\u001b[29Gmemory",
      "format": "{used} / {total} {##be95ff}·{##ff7eb6} {percentage}",
      "outputColor": "#ff7eb6"
    },
    {
      "type": "swap",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ee5396}\uf0ec\u001b[29Gswap",
      "format": "{used} / {total} {##be95ff}·{##ee5396} {percentage}",
      "outputColor": "#ee5396"
    },
    {
      "type": "disk",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf0a0\u001b[29Gdisk",
      "format": "{size-used} / {size-total} {##be95ff}·{##82cfff} {size-percentage} {##be95ff}·{##82cfff} {filesystem}",
      "outputColor": "#82cfff",
      "folders": "/",
      "showExternal": true,
      "showHidden": false
    },
    {
      "type": "display",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##78a9ff}\udb80\udf79\u001b[29Gdisplay",
      "format": "{width}x{height} @ {refresh-rate}Hz {##be95ff}·{##78a9ff} {inch}\" {##be95ff}·{##78a9ff} {ppi} ppi",
      "outputColor": "#78a9ff"
    },
    {
      "type": "battery",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##42be65}\uf240\u001b[29Gbattery",
      "format": "{capacity} {##be95ff}·{##42be65} {status} {##be95ff}·{##42be65} {cycle-count} cycles",
      "outputColor": "#42be65"
    },
    {
      "type": "poweradapter",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ff7eb6}\uf1e6\u001b[29Gpower",
      "format": "{watts}W {##be95ff}·{##ff7eb6} {name}",
      "outputColor": "#ff7eb6"
    },
    {
      "type": "sound",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##be95ff}\uf028\u001b[29Gsound",
      "format": "{name} {##be95ff}·{##be95ff} {volume-percentage}",
      "outputColor": "#be95ff"
    },
    {
      "type": "bluetooth",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##33b1ff}\uf293\u001b[29Gbt",
      "format": "{name} {##be95ff}·{##33b1ff} {battery-percentage}",
      "outputColor": "#33b1ff"
    },

    // ── network ──────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "{##be95ff}├─ [ network ] ────────────────────────────────────────────────────\u001b[90G┤"
    },
    {
      "type": "wifi",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##3ddbd9}\uf1eb\u001b[29Gwifi",
      "format": "{ssid} {##be95ff}·{##3ddbd9} {signal-quality} {##be95ff}·{##3ddbd9} {protocol}",
      "outputColor": "#3ddbd9"
    },
    {
      "type": "localip",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf0e8\u001b[29Glan",
      "format": "{ipv4} {##be95ff}·{##82cfff} {ifname}",
      "outputColor": "#82cfff",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "defaultRouteOnly": true
    },
    {
      "type": "dns",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##78a9ff}\uf0ac\u001b[29Gdns",
      "outputColor": "#78a9ff",
      "showType": "ipv4"
    },
    {
      // The ONE row that leaves the machine: fastfetch asks ipinfo.io/json for the
      // address you appear as, every time it runs. Nothing else here touches the
      // network, and nothing runs fastfetch on your behalf — but this is a system
      // default, so it is worth knowing rather than discovering. Delete this block
      // to stay fully offline; see docs/shell.md.
      "type": "publicip",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ee5396}\uf0c2\u001b[29Gwan",
      "outputColor": "#ee5396",
      "timeout": 800
    },

    // ── toolchain ────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "{##be95ff}├─ [ toolchain ] ──────────────────────────────────────────────────\u001b[90G┤"
    },
    // A probe that finds nothing prints nothing, and fastfetch drops the
    // row entirely — absent toolchains simply do not appear.
    {
      "type": "editor",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##82cfff}\uf044\u001b[29Geditor",
      "format": "{name} {version}",
      "outputColor": "#82cfff"
    },
    {
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##be95ff}\uf1d3\u001b[29Ggit",
      "text": "command -v git >/dev/null 2>&1 || exit 0; git --version | awk '{print $3}'",
      "outputColor": "#be95ff"
    },
    {
      // honours $CC, else cc/gcc/clang; prints the toolchain name + version
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##78a9ff}\ue61e\u001b[29Gc/c++",
      "text": "for c in ${CC:-} cc gcc clang; do command -v $c >/dev/null 2>&1 && break; c=; done; case $c in '') exit 0;; esac; $c --version 2>/dev/null | awk 'NR==1{ n = ($0 ~ /Apple clang/) ? \"Apple Clang\" : (($0 ~ /clang/) ? \"Clang\" : \"GCC\"); if (match($0, /[Vv]ersion [0-9][0-9.]*/)) v = substr($0, RSTART+8, RLENGTH-8); else for (i=1;i<=NF;i++) if ($i ~ /^[0-9][0-9.]*$/) { v=$i; break }; print n, v }'",
      "outputColor": "#78a9ff"
    },
    {
      // vendor comes from the runtime banner (Temurin, Zulu, Corretto, GraalVM …)
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ee5396}\ue738\u001b[29Gjava",
      "text": "command -v java >/dev/null 2>&1 || exit 0; o=$(java -version 2>&1); v=$(printf %s\\n \"$o\" | tr -d '\\042' | awk 'NR==1{print $3}'); case $o in *Temurin*) n=Temurin;; *Zulu*) n=Zulu;; *Corretto*) n=Corretto;; *GraalVM*) n=GraalVM;; *Microsoft*) n=Microsoft;; *Semeru*|*IBM*) n=Semeru;; *Oracle*|*'Java(TM)'*) n=Oracle;; *Homebrew*) n=Homebrew;; *OpenJDK*) n=OpenJDK;; *) n=Java;; esac; printf '%s %s\\n' \"$n\" \"$v\"",
      "outputColor": "#ee5396"
    },
    {
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##33b1ff}\ue73c\u001b[29Gpython",
      "text": "p=python3; command -v $p >/dev/null 2>&1 || p=python; command -v $p >/dev/null 2>&1 || exit 0; $p -V 2>&1 | awk '{print $2}'",
      "outputColor": "#33b1ff"
    },
    {
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ff7eb6}\ue7a8\u001b[29Grust",
      "text": "command -v rustc >/dev/null 2>&1 || exit 0; rustc -V | awk '{print $2}'",
      "outputColor": "#ff7eb6"
    },
    {
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##3ddbd9}\ue626\u001b[29Ggo",
      "text": "command -v go >/dev/null 2>&1 || exit 0; go version | awk '{print substr($3,3)}'",
      "outputColor": "#3ddbd9"
    },
    {
      "type": "command",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##42be65}\ue718\u001b[29Gnode",
      "text": "command -v node >/dev/null 2>&1 || exit 0; node -v | tr -d v",
      "outputColor": "#42be65"
    },
    {
      "type": "custom",
      "format": "{##be95ff}├─ [ session ] ────────────────────────────────────────────────────\u001b[90G┤"
    },
    {
      "type": "uptime",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##42be65}\uf017\u001b[29Guptime",
      "outputColor": "#42be65"
    },
    {
      "type": "processes",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##ff7eb6}\uf0ae\u001b[29Gprocs",
      "outputColor": "#ff7eb6"
    },
    {
      "type": "locale",
      "key": "\u001b[90G{##be95ff}│\u001b[23G│  {##3ddbd9}\uf1ab\u001b[29Glocale",
      "outputColor": "#3ddbd9"
    },

    // ── palette ──────────────────────────────────────────────────────────────
    {
      "type": "custom",
      "format": "{##be95ff}╰──────────────────────────────────────────────────────────────────\u001b[90G╯"
    },
    { "type": "break" },
    {
      "type": "custom",
      "format": "   {##08bdba}███{##3ddbd9}███{##33b1ff}███{##78a9ff}███{##82cfff}███{##be95ff}███{##ee5396}███{##ff7eb6}███{##42be65}███{##525252}███"
    }

    // More modules worth dropping in — copy any key above and swap the label:
    // "board", "chassis", "bios", "brightness", "physicaldisk", "diskio",
    // "netio", "camera", "keyboard", "mouse", "gamepad", "zpool", "btrfs",
    // "vulkan", "opengl", "opencl", "tpm", "weather", "wallpaper".
  ]
}
