// Qubix OS — system-wide Niri configuration.
//
// Read by: niri (KDL format — https://kdl.dev).
//
// LOADING ORDER. Niri looks for $XDG_CONFIG_HOME/niri/config.kdl (i.e.
// ~/.config/niri/config.kdl) and falls back to THIS file. Because this file exists,
// niri will NOT auto-create a per-user config on first login — a user who wants to
// customise the session copies this file to ~/.config/niri/config.kdl first. That is
// documented for users in docs/desktops.md.
//
// This file is a system default kept deliberately small and readable: it is not a copy
// of niri's 600-line annotated default config. For every option not set here, niri's
// built-in default applies. Full reference:
//   /usr/share/doc/niri/wiki/  (shipped in the image)
//   https://github.com/YaLTeR/niri/wiki
//
// The shell is DankMaterialShell (DMS). It is NOT started from here: it runs as a
// systemd user unit pulled in by niri.service — see
// /usr/lib/systemd/user/niri.service.d/50-qubix-dms.conf. Everything below that mentions
// DMS is either a keybind into its IPC or a rule about how it draws.
//
// Xwayland needs no configuration: since niri 25.08 the compositor exports $DISPLAY and
// spawns xwayland-satellite (a hard RPM dependency) on demand.
//
// See docs/desktops.md and docs/design-decisions.md DD-013, DD-014, DD-015.

// ── Input ─────────────────────────────────────────────────────────────────────
// The xkb block is left empty on purpose: niri then takes the keyboard layout from
// org.freedesktop.locale1, which is what the installer and `localectl` set. Hardcoding
// a layout here would override the user's actual choice.
input {
    keyboard {
        xkb {}
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
}

// ── Layout ────────────────────────────────────────────────────────────────────
// Niri is a scrollable-tiling compositor: windows form an infinite horizontal strip
// of columns rather than a subdivided rectangle.
//
// STRUCTURE ONLY — no colours. Those live in qubix-theme.kdl, included below.
layout {
    gaps 8

    // DMS paints its own backdrop; leaving this transparent avoids a coloured band
    // showing through in the overview. With no wallpaper drawn, what shows through is
    // the theme's overview backdrop-color, the palette's deepest tone.
    background-color "transparent"

    // Widths cycled by Mod+R. Fractions of the output width.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
}

// ── Theme ─────────────────────────────────────────────────────────────────────
// Every colour niri draws lives in qubix-theme.kdl, next to this file. It is a separate
// file on purpose: a personal ~/.config/niri/config.kdl replaces this one wholesale, so
// keeping the palette separate lets you keep your own config AND go on receiving theme
// updates, with one line:
//
//     include "/etc/niri/qubix-theme.kdl"
//
// Niri watches included files, so a rebase that changes the palette live-reloads.
//
// POSITION MATTERS: includes override what precedes them. This sits after the layout
// block above, whose structure it does not touch, and before the DMS include at the
// bottom, which is allowed to win. DD-022, DD-025.
include "qubix-theme.kdl"

// ── Outputs ───────────────────────────────────────────────────────────────────
// With `scale` unset, niri GUESSES a scale from the output's physical size and
// resolution. On a ~14" 1920×1200 laptop panel that guess is 1.25. Pin it to 1.
//
// NIRI HAS NO GLOBAL SCALE SETTING and no wildcard: an `output` block matches a connector
// name, or a "manufacturer model serial" triple. So the only way to say this in a shipped
// config is to name a connector, and `eDP-1` is the conventional name for a laptop's
// built-in panel. Run `niri msg outputs` to see what yours is actually called.
//
// Only this one output is pinned. External monitors are left alone and keep the automatic
// guess, which is usually right for them.
//
// If your built-in panel is genuinely HiDPI, delete this block — niri's guess is better
// than a forced 1. See DD-024.
output "eDP-1" {
    scale 1
}

// Ask applications to omit their own title bars so niri can draw borders around them.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── Layer rules ───────────────────────────────────────────────────────────────
// DMS's panels and popups are Quickshell layer-shell surfaces. Placing them within the
// backdrop keeps them visible behind windows in the overview instead of floating on top
// of it.
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// ── Window rules ──────────────────────────────────────────────────────────────
// WezTerm sizes itself from its initial configure event; an empty default-column-width
// lets it pick its own width instead of being forced to 50%. This rule is carried over
// from niri's own default config.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
    draw-border-with-background false
}

// Xwayland Video Bridge — keep it out of sight if it is ever started.
//
// The bridge (`xwaylandvideobridge`, "Wayland to X Recording bridge") is an Aurora/KDE
// component that republishes a Wayland screen capture as an X11 window, so X11 apps —
// Discord, Zoom, OBS — can record the screen.
//
// It is designed to be INVISIBLE and relies on the compositor to make it so: KDE ships a
// KWin rule for exactly that. Niri has no such rule, so the bridge opens as a blank window
// over a fresh session — see https://github.com/niri-wm/niri/issues/2367. This rule is
// niri's equivalent of the KWin one.
//
// SECOND LINE OF DEFENCE ONLY. The bridge no longer autostarts here at all — see
// files/system/etc/xdg/autostart/org.kde.xwaylandvideobridge.desktop — because a hidden
// window is still a window: it stays in niri's toplevel list and so kept appearing in
// DankMaterialShell's bar. This rule covers the case where someone runs the bridge by
// hand, which is the supported way to get X11 screen capture in this session.
//
// See DD-019 (this rule) and DD-021 (why it was not enough on its own).
window-rule {
    match app-id=r#"^xwaylandvideobridge$"#

    // Out of the tiling layout, so it cannot take a column and push windows aside.
    open-floating true
    // It must not steal focus at login — that is what made the session look dead.
    open-focused false
    // Belt and braces: a fullscreen window renders ABOVE the top layer in niri, which
    // would hide the DankMaterialShell bar as well as every other window.
    open-fullscreen false
    // One logical pixel, parked in the corner, fully transparent.
    default-column-width { fixed 1; }
    default-window-height { fixed 1; }
    default-floating-position x=0 y=0 relative-to="bottom-right"
    opacity 0.0
}

// ── Key bindings ──────────────────────────────────────────────────────────────
// "Mod" is Super (the Meta/Windows key) in a normal session.
//
// `dms ipc call …` drives the running shell. The command names follow
// DankMaterialShell's own recommended niri binds, so they stay recognisable to anyone
// reading upstream's documentation.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications. WezTerm is the system default terminal — see DD-012.
    Mod+T hotkey-overlay-title="Open a Terminal" { spawn "wezterm"; }
    Mod+Space hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard History" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+N hotkey-overlay-title="Notification Centre" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Comma hotkey-overlay-title="Shell Settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+M hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }

    // Screen capture for X11 applications. The Xwayland Video Bridge does not autostart
    // in this session (DD-021), so this is how you turn it on for as long as Discord,
    // Zoom, or an older OBS needs it. The script reports what it did in a notification.
    Mod+Shift+B hotkey-overlay-title="X11 Screen Capture (toggle)" { spawn "qubix-video-bridge"; }

    // Session.
    Mod+Alt+L hotkey-overlay-title="Lock the Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+X hotkey-overlay-title="Power Menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Overview: a zoomed-out view of every workspace on every monitor.
    Mod+O repeat=false { toggle-overview; }

    // Focus. Arrow keys and hjkl are equivalent throughout.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Move the focused window.
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // Monitors.
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    // Workspaces. Niri's workspaces are dynamic and stack vertically.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Shift+U   { move-column-to-workspace-down; }
    Mod+Shift+I   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Sizing and layout.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Pull the neighbouring window into / push it out of the focused column.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Screenshots. Written to screenshot-path above; Print alone opens the interactive
    // region selector.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Media, volume, and brightness. Routed through DMS so its on-screen display
    // appears. allow-when-locked lets them work on the lock screen.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute         allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioPlay         allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPause        allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev         allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext         allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
}

// ── DankMaterialShell theming ─────────────────────────────────────────────────
// DMS generates a Material colour scheme from the wallpaper with matugen and writes it
// to ~/.config/niri/dms/colors.kdl. Including it here is what makes niri's focus ring,
// borders and tab indicators follow the shell's accent colour.
//
// It therefore REPLACES the #56728B palette above for anyone who turns dynamic theming
// on. That is the intended trade (DD-015): the shipped palette is the default, not a
// lock. Delete this include to keep the palette regardless of the wallpaper.
//
// `optional=true` means a missing file is not an error, so this is inert until the user
// enables dynamic theming. Absolute (`~`-expanded) rather than relative, because a
// relative include would resolve against /etc/niri/ — this file's own directory — and
// DMS writes into the user's config directory.
//
// POSITION MATTERS: includes override options set *before* them, so this must stay at
// the end of the file, after the layout block it is meant to override.
include optional=true "~/.config/niri/dms/colors.kdl"
