# useradd defaults file
#
# Read by: useradd(8), when an account is created.
#
# REPLACES shadow-utils' copy. Every value below is upstream's except SHELL — Fedora ships
# /bin/bash. Keep the rest in step with shadow-utils' `shadow-utils.useradd` if it ever
# changes; there is no drop-in directory for this file, so shipping it means owning it.
#
# THIS ONLY AFFECTS ACCOUNTS CREATED FROM NOW ON. The login shell of an account that
# already exists is a field in /etc/passwd, which an image cannot write. For that one:
#
#     chsh -s /usr/bin/zsh
#
# Qubix OS configures both shells (DD-026), so an account still on bash gets the prompt
# and the aliases — it is the four zsh-only tools that are missing. See docs/shell.md
# and DD-030.
GROUP=100
HOME=/home
INACTIVE=-1
EXPIRE=
SHELL=/usr/bin/zsh
SKEL=/etc/skel
CREATE_MAIL_SPOOL=yes
