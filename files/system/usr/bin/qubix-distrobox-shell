#!/bin/sh
#
# qubix-distrobox-shell — give a distrobox container the host's interactive shell.
#
# Runs INSIDE a container, as root. /etc/distrobox/distrobox.conf names it as
# `container_init_hook`, so `distrobox create` runs it through distrobox-init at the end of
# container setup, once. Running it again is how an existing container catches up:
#
#     distrobox enter <name> -- sudo /run/host/usr/bin/qubix-distrobox-shell
#
# A re-run REPLACES the block it wrote in the container's global zshrc rather than seeing one
# and leaving the file alone, so a container that already exists receives a change made here
# — which is the only route a fix has to a container, since nothing in it is rebuilt by a
# rebase. Everything else in here was already idempotent (DD-046).
#
# WHY ANYTHING IS NEEDED. A container is a different distribution — its own /etc, its own
# /usr, its own package manager — and every tool in docs/shell.md is a host package read
# from a host path. distrobox brings across the SHELL (it installs the package named by
# $SHELL and gives the container user that shell) and it shares $HOME. That is the whole of
# its help; the prompt, the history search and the plugins are this script's job.
#
# INSTALL IT, OR BORROW IT FROM THE HOST, IN THAT ORDER. The container's own package is
# always better: it is built for this distribution. What the container cannot install is
# taken from /run/host — plain text (the shell files, the plugins, the configuration) always,
# and a host BINARY only after it has been run in here once to prove it can be. A Fedora
# binary does not run against musl or an older glibc, and `--version` is the only honest test
# of that.
#
# WHY NOTHING IS COPIED. One symlink, /usr/share/qubix-os -> /run/host/usr/share/qubix-os,
# makes every absolute path in the host's shell files resolve inside the container — and so
# do STARSHIP_CONFIG and LG_CONFIG_FILE, which the host exports into it. A rebase then
# changes the container's shell too, with nothing to re-run and nothing to go stale. It is
# DD-030 one level down.
#
# ── EVERYTHING IT PRINTS IS READ BY A MACHINE ────────────────────────────────────────────
# `distrobox enter` follows the container's log while it initialises and switches on the
# start of each line (distrobox-enter, the `while IFS= read -r line` loop):
#
#     Error:*      printed in red, and `exit 1` — THE ENTER IS ABANDONED
#     Warning:*    printed in yellow
#     distrobox:*  becomes the name of the setup step being shown
#     anything else is discarded, stdout and stderr alike
#
# Two consequences, and they are the shape of this script:
#
#   1. NO OUTPUT OF OURS, AND NONE OF ANY COMMAND WE RUN, MAY BEGIN WITH `Error:`. dnf
#      prints `Error: Unable to find a match: …` for a package a distribution does not have,
#      which is an ordinary thing to happen in a container and used to kill the enter. So
#      every package manager runs with its output captured to a file, and the file is only
#      ever echoed back through warn(), which re-prefixes each line.
#   2. Only the two prefixes above are visible at all, which is why say() and warn() use
#      them rather than this script's own name. Run by hand, the prefixes are noise; run by
#      distrobox, they are the difference between being seen and not existing.
#
# IT MUST ALSO NEVER EXIT NON-ZERO. distrobox-init runs with `set -o errexit` and eval's
# this hook, so a failure aborts container creation and leaves a half-built container. Every
# step is best-effort and the script exits 0 from inside a container whatever happened. The
# only non-zero exits are the two preconditions below, which can fail only when a human runs
# it in the wrong place.
#
# See docs/shell.md and docs/design-decisions.md DD-043, DD-045, DD-046.

set -u

HOST_ROOT=/run/host
QUBIX_SHARE=/usr/share/qubix-os
HOST_SHARE="$HOST_ROOT$QUBIX_SHARE"
PKG_LOG=/var/tmp/qubix-distrobox-shell.log

# A step distrobox will show, and a warning distrobox will show in yellow. Never `Error:`.
say() { printf 'distrobox: qubix-shell: %s\n' "$*"; }
warn() { printf 'Warning: qubix-shell: %s\n' "$*"; }

# Echo a captured log back safely: every line is re-prefixed, so a package manager's own
# `Error:` line cannot reach distrobox's watcher and end the enter.
warn_log() {
    [ -s "$PKG_LOG" ] || return 0
    warn "the last few lines of $PKG_LOG:"
    tail -n 5 "$PKG_LOG" 2>/dev/null | while IFS= read -r line; do
        warn "  $line"
    done
}

# ── Preconditions ─────────────────────────────────────────────────────────────
# Refuse to run on the host. Everything below writes to /etc and /usr as though they were a
# container's, and on the host that would mean appending a SECOND source block to the
# /etc/zshrc the build already wired (common-base.yml, module 4f).
#
# /run/.containerenv is podman's, /.dockerenv is docker's, /run/.toolboxenv is written by
# distrobox-init itself for toolbx compatibility.
if [ ! -e /run/.containerenv ] && [ ! -e /.dockerenv ] && [ ! -e /run/.toolboxenv ]; then
    warn "this is not a container — run it inside a distrobox, not on the host"
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    warn "must run as root: distrobox enter <name> -- sudo $0"
    exit 1
fi

# From here on nothing exits non-zero. See the header.
if [ ! -d "$HOST_SHARE" ]; then
    warn "$HOST_SHARE is not there, so either the host root is not mounted at $HOST_ROOT"
    warn "or this host is not Qubix OS. Leaving the container as distrobox built it."
    exit 0
fi

say "setting up the Qubix shell"
: >"$PKG_LOG" 2>/dev/null || PKG_LOG=/dev/null

# ── What the container needs of its own ───────────────────────────────────────
# Three binaries, two plugin scripts that belong beside the container's own zsh, and zsh
# itself for the case where the container was created while the host account was on bash.
#
# ONE LIST FOR EVERY DISTRIBUTION, AND MISSING NAMES ARE NORMAL. These are all in Fedora,
# Arch and Alpine; Debian and Ubuntu have neither starship nor atuin, and a minimal RHEL or
# UBI container has none of the five. Whatever a container cannot install is filled in from
# the host below, or reported. This is why the list is never handed to
# `container_additional_packages` in distrobox.conf: distrobox installs that in one
# transaction under `set -e`, and one unknown name would abort the container.
PACKAGES="zsh zsh-autosuggestions zsh-syntax-highlighting starship atuin bat"

# ── The container's package manager ───────────────────────────────────────────
# In the order a container that has two of them should be driven: dnf5 before dnf (Fedora
# 41+ answers to both names). apt-get, pacman and apk are refreshed first, because toolbox
# images ship without a package index and their install would otherwise fail on every name.
#
# SKIP-UNAVAILABLE WHERE THE MANAGER HAS IT (dnf5's `--skip-unavailable`, dnf4's
# `strict=0`, zypper's `--ignore-unknown`): one transaction then installs what exists and
# ignores the rest, which is both faster and quieter than finding out name by name. The
# others get the name-by-name pass below instead.
#
# THE FLAG IS KEPT SEPARATE FROM THE COMMAND on purpose: an older manager that does not
# know the flag fails on the flag, not on the packages, and the name-by-name pass below
# would fail identically if it inherited it. It runs without.
install_cmd=""
skip_flag=""
if command -v dnf5 >/dev/null 2>&1; then
    install_cmd="dnf5 install -y"
    skip_flag="--skip-unavailable"
elif command -v dnf >/dev/null 2>&1; then
    install_cmd="dnf install -y"
    skip_flag="--setopt=strict=0"
elif command -v microdnf >/dev/null 2>&1; then
    install_cmd="microdnf install -y"
elif command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive
    export DEBIAN_FRONTEND
    apt-get update -qq >>"$PKG_LOG" 2>&1 || warn "apt-get update failed; see $PKG_LOG"
    install_cmd="apt-get install -y --no-install-recommends"
elif command -v pacman >/dev/null 2>&1; then
    pacman -Sy --noconfirm >>"$PKG_LOG" 2>&1 || warn "pacman -Sy failed; see $PKG_LOG"
    install_cmd="pacman -S --needed --noconfirm"
elif command -v zypper >/dev/null 2>&1; then
    zypper --non-interactive refresh >>"$PKG_LOG" 2>&1 || warn "zypper refresh failed"
    install_cmd="zypper --non-interactive install"
    skip_flag="--ignore-unknown"
elif command -v apk >/dev/null 2>&1; then
    apk update >>"$PKG_LOG" 2>&1 || warn "apk update failed; see $PKG_LOG"
    install_cmd="apk add"
fi

# EVERY PACKAGE MANAGER RUNS WITH ITS OUTPUT CAPTURED. See the header: one `Error:` line in
# the container's log ends `distrobox enter`, and "this distribution does not carry starship"
# is not an error worth ending anything over.
if [ -z "$install_cmd" ]; then
    warn "no package manager I recognise here; whatever the host can lend is used instead"
else
    say "installing what this distribution has: $PACKAGES"
    # Unquoted on purpose: all three are word lists, not single arguments.
    # shellcheck disable=SC2086
    if ! $install_cmd $skip_flag $PACKAGES >>"$PKG_LOG" 2>&1; then
        # A manager with no skip-unavailable flag, one that does not know the flag we tried,
        # or a transaction that failed for its own reasons. Name by name, and without the
        # flag, so one name a distribution does not carry costs the others nothing.
        for pkg in $PACKAGES; do
            # shellcheck disable=SC2086
            $install_cmd "$pkg" >>"$PKG_LOG" 2>&1 || :
        done
    fi
fi

# ── Two things distributions disagree about ───────────────────────────────────
# Both are absorbed here rather than by teaching the host's shell files about every
# distribution: those files are the host's, and they should go on describing the host.
#
# The plugins install to /usr/share/<name>/ on Fedora, Debian and Ubuntu, and to
# /usr/share/zsh/plugins/<name>/ on Arch and Alpine. shell/qubix.zsh names the first, so
# anything else gets a link at the name it looks for. The file is SEARCHED FOR rather than
# guessed at from a list of distributions, because that list would be wrong for the next one
# — and if this container has no copy at all, the host's is plain zsh and does just as well.
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    [ -e "/usr/share/$plugin/$plugin.zsh" ] && continue
    src="$(find /usr/share -maxdepth 4 -name "$plugin.zsh" 2>/dev/null | head -n 1)"
    if [ -z "$src" ] && [ -r "$HOST_ROOT/usr/share/$plugin/$plugin.zsh" ]; then
        src="$HOST_ROOT/usr/share/$plugin/$plugin.zsh"
    fi
    [ -n "$src" ] || continue
    src_dir="$(dirname "$src")"
    ln -sfn "$src_dir" "/usr/share/$plugin" && say "$plugin from $src_dir"
done

# Debian and Ubuntu install bat as `batcat`, because the name `bat` belongs to another
# package there. shell/common.sh looks for `bat`, so give it one.
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
    install -d -m 0755 /usr/local/bin
    ln -sfn "$(command -v batcat)" /usr/local/bin/bat && say "bat from batcat"
fi

# ── What the container could not install, borrowed from the host ──────────────
# ONLY AFTER IT HAS BEEN PROVED TO RUN IN HERE. These are dynamically linked against the
# host's glibc: a Fedora-family container of a similar vintage runs them, musl (Alpine,
# Wolfi) cannot run them at all, and an older glibc (Debian 11) fails on a missing symbol.
# `--version` costs one exec and is the difference between a prompt and a shell that prints
# a loader error before every command.
#
# Linked into /usr/local/bin — which distrobox puts on $PATH — rather than by putting
# /run/host/usr/bin on $PATH, which would expose every host binary to the container and make
# `command -v` lie about what this distribution has.
for tool in starship atuin bat; do
    command -v "$tool" >/dev/null 2>&1 && continue
    host_bin="$HOST_ROOT/usr/bin/$tool"
    [ -x "$host_bin" ] || continue
    if "$host_bin" --version >/dev/null 2>&1; then
        install -d -m 0755 /usr/local/bin
        ln -sfn "$host_bin" "/usr/local/bin/$tool" && say "$tool from the host binary"
    else
        warn "the host $tool will not run in this container (different libc), so it is left out"
    fi
done

# ── The host's configuration, at the path its own files name ──────────────────
# The single symlink the design rests on. With it, /usr/share/qubix-os/shell/qubix.zsh,
# /usr/share/qubix-os/starship.toml and /usr/share/qubix-os/lazygit/config.yml all mean the
# host's copy — including when they arrive as STARSHIP_CONFIG or LG_CONFIG_FILE in the
# environment distrobox passes in from the host shell.
if [ -L "$QUBIX_SHARE" ] || [ ! -e "$QUBIX_SHARE" ]; then
    install -d -m 0755 /usr/share
    if ln -sfn "$HOST_SHARE" "$QUBIX_SHARE"; then
        say "$QUBIX_SHARE from $HOST_SHARE"
    else
        warn "could not link $QUBIX_SHARE; the shell setup below will find nothing"
    fi
else
    warn "$QUBIX_SHARE exists and is not a symlink — leaving it alone"
fi

# ── The environment, and bash ─────────────────────────────────────────────────
# The host's own /etc/profile.d file, linked rather than copied for the reason in the
# header. It re-resolves STARSHIP_CONFIG, the ATUIN_* block and LG_CONFIG_FILE in every
# shell (DD-037), so inside the container they are resolved against the shared $HOME and
# the symlink above instead of being inherited from whichever host shell ran `distrobox
# enter`. Its last block wires bash, which is how bash in a container gets the prompt too.
env_file=/etc/profile.d/qubix-shell-env.sh
host_env_file="$HOST_ROOT$env_file"
if [ ! -e "$host_env_file" ]; then
    warn "$host_env_file is missing on the host; bash here will get no prompt"
elif [ -e "$env_file" ] && [ ! -L "$env_file" ]; then
    warn "$env_file exists and is not a symlink — leaving it alone"
else
    install -d -m 0755 /etc/profile.d
    ln -sfn "$host_env_file" "$env_file" || warn "could not link $env_file"
fi

# ── zsh ───────────────────────────────────────────────────────────────────────
# WHERE THE GLOBAL RC FILE IS depends on how zsh was compiled: Fedora reads /etc/zshrc,
# Debian, Arch and Alpine read /etc/zsh/zshrc. zsh will not say which, so the directory is
# identified by the global startup files it already contains, and /etc/zsh is preferred
# because it only exists on the distributions that use it.
zsh_etc=""
for dir in /etc/zsh /etc; do
    for base in zshrc zshenv zprofile zlogin; do
        if [ -f "$dir/$base" ]; then
            zsh_etc="$dir"
            break
        fi
    done
    [ -n "$zsh_etc" ] && break
done

if ! command -v zsh >/dev/null 2>&1; then
    warn "zsh is not installed here, so the zsh half is skipped"
elif [ -z "$zsh_etc" ]; then
    warn "no global zsh startup file in /etc or /etc/zsh, so I cannot tell which zsh reads"
else
    zshrc="$zsh_etc/zshrc"

    # REPLACED, NOT SKIPPED. The block is delimited by the two markers below, and a re-run
    # deletes everything between them before appending the current one. Skipping a file that
    # already carried a block — which is what this used to do — meant a container was stuck
    # with whatever the image shipped on the day it was created, and the documented catch-up
    # command could not deliver a fix to it. The end marker is what makes the range
    # deletable; a block written before it existed ran to the end of the file, which is what
    # the `$` fallback covers. See DD-046.
    block_start='# ── Qubix OS ──'
    block_end='# ── end of the Qubix OS block ──'

    # BUILT BESIDE THE FILE, INSTALLED OVER IT ONLY IF IT PARSES. The old block is removed
    # and the new one appended in a candidate file, so a failure anywhere in here — a sed
    # that cannot run, a block that does not parse — leaves the container's own zshrc
    # untouched rather than half-rewritten. It is installed with `cat`, not `mv`, so the
    # file keeps its own mode, owner and SELinux label.
    [ -f "$zshrc" ] || : >"$zshrc"
    candidate="$zshrc.qubix-new"
    rm -f "$candidate"

    verb="wired"
    written=""
    start_line="$(grep -n -F -- "$block_start" "$zshrc" 2>/dev/null | head -n 1 | cut -d: -f1)"
    if [ -n "$start_line" ]; then
        # A block written before the end marker existed has no end: it ran to the end of the
        # file, which is what `$` covers — and which is why the one-off case is announced.
        # Anything a person added to the container's zshrc AFTER that block goes with it, and
        # there is no way to tell where the block stopped and their lines began.
        end_line="$(grep -n -F -- "$block_end" "$zshrc" 2>/dev/null | head -n 1 | cut -d: -f1)"
        if [ -z "$end_line" ]; then
            end_line='$'
            warn "$zshrc has a Qubix block from before the end marker: it, and anything below"
            warn "it, is replaced. The file as it was is $zshrc.qubix-old."
            cp -p "$zshrc" "$zshrc.qubix-old" 2>/dev/null || :
        fi
        verb="refreshed"
        sed "${start_line},${end_line}d" "$zshrc" >"$candidate" && written=yes
    else
        cat "$zshrc" >"$candidate" && written=yes
    fi

    if [ -n "$written" ]; then
        printf '%s\n' \
            "${block_start}────────────────────────────────────────────────────────────────" \
            '# Appended by /run/host/usr/bin/qubix-distrobox-shell, which ran in here when' \
            '# distrobox created this container. Run it again (with sudo) and everything between' \
            '# this line and the end marker below is REPLACED by the current image'"'"'s version —' \
            '# which is how a container catches up with one command.' \
            '# Everything zsh gets interactively is in the file below, and' \
            '# that file is the HOST copy, reached through the /usr/share/qubix-os symlink — so a' \
            '# rebase of the host changes this container too, with nothing to re-run in here.' \
            '#' \
            '# LAST IN THIS FILE, and before ~/.zshrc, for the same reasons as on the host: see' \
            '# docs/shell.md. Your own ~/.zshrc runs after it and still wins.' \
            '#' \
            '# THE HOST'"'"'S COMPLETION FUNCTIONS ARE DELIBERATELY NOT PUT ON $fpath here.' \
            '# compaudit cannot establish ownership through the /run/host bind mount — the host'"'"'s' \
            '# root maps to an unmapped uid in the container — so it calls that directory insecure' \
            '# and every compinit that is not given -u stops to ask. Running compinit -u from this' \
            '# block did not settle it: any LATER compinit asks again — Fedora'"'"'s skeleton ~/.zshrc' \
            '# runs one, after this file — and answering it makes compinit drop the insecure' \
            '# directory from $fpath anyway. So the container uses its own completions, and no' \
            '# shell has a question to ask. See DD-046.' \
            'if [[ -r /usr/share/qubix-os/shell/qubix.zsh ]]; then' \
            '    source /usr/share/qubix-os/shell/qubix.zsh' \
            'fi' \
            "${block_end}───────────────────────────────────────────────" \
            >>"$candidate" || written=""
    fi

    if [ -z "$written" ]; then
        rm -f "$candidate"
        warn "could not rewrite $zshrc, so it is exactly as it was and zsh keeps its own setup"
    elif ! zsh -n "$candidate" 2>/dev/null; then
        rm -f "$candidate"
        warn "$zshrc does not parse with the Qubix block, so it is left exactly as it was"
    elif cat "$candidate" >"$zshrc"; then
        rm -f "$candidate"
        say "zsh $verb from the end of $zshrc"
    else
        warn "could not write $zshrc; the rewritten file is beside it, at $candidate"
    fi
fi

# ── The container user's login shell ──────────────────────────────────────────
# distrobox gives the container user the shell the HOST account had AT CREATION TIME. A
# container created before qubix-default-shell.service moved that account to zsh therefore
# has a bash user in it, and re-running this script is how that is fixed.
#
# THE HOST ACCOUNT DECIDES, and only bash is ever replaced — the same rule
# qubix-default-shell follows on the host (DD-035): an account on anything else chose it,
# and a choice is not something to overrule. UID 1000–60000 is the human range, which is
# what keeps root's shell out of this.
zsh_path="$(command -v zsh 2>/dev/null)"
if [ -n "$zsh_path" ] && command -v usermod >/dev/null 2>&1; then
    while IFS=: read -r name _ uid _ _ _ shell; do
        [ "${uid:-0}" -ge 1000 ] && [ "${uid:-0}" -lt 60000 ] || continue

        case "$shell" in
            /bin/bash | /usr/bin/bash) ;;
            *) continue ;;
        esac

        host_shell="$(grep -m1 "^$name:" "$HOST_ROOT/etc/passwd" 2>/dev/null | cut -d: -f7)"
        case "${host_shell:-}" in
            */zsh) ;;
            *) continue ;;
        esac

        if usermod -s "$zsh_path" "$name" >>"$PKG_LOG" 2>&1; then
            say "$name now logs in to $zsh_path, as on the host"
        else
            warn "could not make $zsh_path the login shell for $name"
        fi
    done </etc/passwd
fi

# ── What the container ended up with ──────────────────────────────────────────
# Reality, not the installer's exit codes: every line above is best-effort, and a tool that
# is quietly absent is the failure mode of every guard in the shell files, which skip what
# is not installed by design.
have=""
lack=""
for tool in zsh starship atuin bat; do
    if command -v "$tool" >/dev/null 2>&1; then
        have="$have $tool"
    else
        lack="$lack $tool"
    fi
done
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    if [ -r "/usr/share/$plugin/$plugin.zsh" ]; then
        have="$have $plugin"
    else
        lack="$lack $plugin"
    fi
done

say "ready:${have:- nothing}"
if [ -n "$lack" ]; then
    warn "not available in this container:$lack — the shell setup skips what is missing"
    warn_log
fi

exit 0
