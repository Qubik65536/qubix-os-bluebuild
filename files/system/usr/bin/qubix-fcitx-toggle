#!/usr/bin/bash
#
# qubix-fcitx-toggle — deterministically switch Qubix OS's English/Pinyin Fcitx group.
#
# Called by Niri's Ctrl+Space binding. Fcitx's generic remote `-t` operation toggles its
# active state, but that transition can be ignored by a focused Wayland input context.
# Querying the current engine and explicitly selecting the other profile item avoids that
# ambiguity. The engine IDs match /etc/xdg/fcitx5/profile. DD-050.

set -u

# The override exists for the build-independent logic check; normal sessions always use
# the packaged absolute path.
FCITX_REMOTE=${QUBIX_FCITX_REMOTE:-/usr/bin/fcitx5-remote}

# ── Feedback ──────────────────────────────────────────────────────────────────
# A compositor keybind has no terminal, so make failures visible without turning
# notify-send into a hard dependency.
notify_failure() {
	printf '%s\n' "$1" >&2
	if command -v notify-send >/dev/null 2>&1; then
		notify-send --app-name='Qubix OS Input Method' \
			--icon=input-keyboard \
			'Input method switch failed' "$1" || true
	fi
}

# ── Resolve the current engine ────────────────────────────────────────────────
# --check prevents D-Bus activation from hiding a failed session startup. `-n` returns
# the current input-method ID, which is stable even when no candidate popup is visible.
if ! current_im="$("$FCITX_REMOTE" --check -n 2>/dev/null)"; then
	notify_failure 'Fcitx 5 is not running or cannot be reached in this session.'
	exit 1
fi

# ── Select the other profile item ─────────────────────────────────────────────
case "$current_im" in
	pinyin) target_im=keyboard-us ;;
	*) target_im=pinyin ;;
esac

if ! "$FCITX_REMOTE" --check -s "$target_im"; then
	notify_failure "Fcitx 5 could not select $target_im. Check its Default input-method group."
	exit 1
fi

# SetCurrentIM has no return payload, so a D-Bus success does not prove that a personal
# profile accepted the requested engine. Read it back and surface that otherwise-silent
# case; a stale ~/.config/fcitx5/profile commonly shadows the image's two-engine fallback.
if ! selected_im="$("$FCITX_REMOTE" --check -n 2>/dev/null)" || [ "$selected_im" != "$target_im" ]; then
	notify_failure "Fcitx 5 did not select $target_im. Check ~/.config/fcitx5/profile for both keyboard-us and pinyin."
	exit 1
fi
